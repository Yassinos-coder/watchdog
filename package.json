{
  "name": "watchdog",
  "version": "0.11.1",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=26.0.0",
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "verify:packages": "node scripts/verify-packages.mjs",
    "changeset": "changeset",
    "version-packages": "node scripts/release-notes.mjs && changeset version && node scripts/sync-versions.mjs",
    "release": "node scripts/publish-packages.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.6.2",
    "publint": "^0.3.25",
    "turbo": "^2.5.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.45"
  }
}
