generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum MfaMethod {
  TOTP
  PASSKEY
  EMAIL
}

model User {
  id                   String      @id @default(uuid())
  email                String      @unique
  name                 String
  passwordHash         String
  role                 UserRole    @default(MEMBER)
  mfaMethods           MfaMethod[]
  totpSecretEnc        String?
  totpPendingSecretEnc String?
  failedLoginCount     Int         @default(0)
  lockedUntil          DateTime?
  disabledAt           DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  sessions      Session[]
  passkeys      Passkey[]
  recoveryCodes RecoveryCode[]

  @@map("users")
}

model Session {
  id                  String    @id @default(uuid())
  userId              String
  tokenHash           String    @unique
  mfaPassed           Boolean   @default(false)
  expiresAt           DateTime
  userAgent           String?
  ip                  String?
  webauthnChallenge   String?
  emailOtpHash        String?
  emailOtpExpiresAt   DateTime?
  mfaAttempts         Int       @default(0)
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Passkey {
  id         String    @id
  userId     String
  name       String
  publicKey  Bytes
  counter    BigInt    @default(0)
  transports String[]
  deviceType String
  backedUp   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

enum IssueStatus {
  UNRESOLVED
  RESOLVED
  IGNORED
}

model Project {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  platform         String   @default("javascript")
  uploadTokenHash  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  keys     ProjectKey[]
  issues   Issue[]
  events   Event[]
  releases Release[]

  @@map("projects")
}

model ProjectKey {
  id        String   @id @default(uuid())
  projectId String
  publicKey String   @unique
  label     String   @default("Default")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_keys")
}

model Issue {
  id           String      @id @default(uuid())
  projectId    String
  fingerprint  String
  title        String
  culprit      String?
  level        String      @default("error")
  platform     String?
  status       IssueStatus @default(UNRESOLVED)
  firstSeen    DateTime
  lastSeen     DateTime
  eventCount   Int         @default(1)
  firstRelease String?
  lastRelease  String?
  regressedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events  Event[]

  @@unique([projectId, fingerprint])
  @@index([projectId, status, lastSeen])
  @@map("issues")
}

model Event {
  id          String   @id @default(uuid())
  eventId     String
  projectId   String
  issueId     String
  timestamp   DateTime
  level       String
  message     String
  release     String?
  environment String?
  platform    String?
  payload     Json
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue   Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([projectId, eventId])
  @@index([issueId, timestamp])
  @@index([projectId, timestamp])
  @@map("events")
}

model Release {
  id        String   @id @default(uuid())
  projectId String
  version   String
  createdAt DateTime @default(now())

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceMaps SourceMap[]

  @@unique([projectId, version])
  @@map("releases")
}

model SourceMap {
  id        String   @id @default(uuid())
  releaseId String
  filePath  String
  content   Bytes
  size      Int
  createdAt DateTime @default(now())

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, filePath])
  @@map("source_maps")
}
