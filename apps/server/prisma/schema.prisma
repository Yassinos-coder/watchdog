generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum MfaMethod {
  TOTP
  PASSKEY
  EMAIL
}

model User {
  id                   String      @id @default(uuid())
  email                String      @unique
  name                 String
  passwordHash         String
  role                 UserRole    @default(MEMBER)
  mfaMethods           MfaMethod[]
  totpSecretEnc        String?
  totpPendingSecretEnc String?
  failedLoginCount     Int         @default(0)
  lockedUntil          DateTime?
  disabledAt           DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  sessions      Session[]
  passkeys      Passkey[]
  recoveryCodes RecoveryCode[]
  invites       Invite[]

  @@map("users")
}

model Session {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  mfaPassed         Boolean   @default(false)
  expiresAt         DateTime
  userAgent         String?
  ip                String?
  webauthnChallenge String?
  emailOtpHash      String?
  emailOtpExpiresAt DateTime?
  mfaAttempts       Int       @default(0)
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Passkey {
  id         String    @id
  userId     String
  name       String
  publicKey  Bytes
  counter    BigInt    @default(0)
  transports String[]
  deviceType String
  backedUp   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

enum IssueStatus {
  UNRESOLVED
  RESOLVED
  IGNORED
}

model Project {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  platform         String   @default("javascript")
  uploadTokenHash  String?
  dashboardsSeeded Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  keys          ProjectKey[]
  issues        Issue[]
  events        Event[]
  releases      Release[]
  alertRules    AlertRule[]
  transactions  Transaction[]
  metrics       Metric[]
  metricRollups MetricRollup[]
  dashboards    Dashboard[]
  replays       Replay[]

  @@map("projects")
}

model ProjectKey {
  id        String   @id @default(uuid())
  projectId String
  publicKey String   @unique
  label     String   @default("Default")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_keys")
}

model Issue {
  id           String      @id @default(uuid())
  projectId    String
  fingerprint  String
  title        String
  culprit      String?
  level        String      @default("error")
  platform     String?
  status       IssueStatus @default(UNRESOLVED)
  firstSeen    DateTime
  lastSeen     DateTime
  eventCount   Int         @default(1)
  firstRelease String?
  lastRelease  String?
  regressedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events  Event[]

  @@unique([projectId, fingerprint])
  @@index([projectId, status, lastSeen])
  @@map("issues")
}

model Event {
  id          String   @id @default(uuid())
  eventId     String
  projectId   String
  issueId     String
  timestamp   DateTime
  level       String
  message     String
  release     String?
  environment String?
  platform    String?
  payload     Json
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue   Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([projectId, eventId])
  @@index([issueId, timestamp])
  @@index([projectId, timestamp])
  @@map("events")
}

model Release {
  id        String   @id @default(uuid())
  projectId String
  version   String
  createdAt DateTime @default(now())

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceMaps SourceMap[]

  @@unique([projectId, version])
  @@map("releases")
}

model SourceMap {
  id        String   @id @default(uuid())
  releaseId String
  filePath  String
  content   Bytes
  size      Int
  createdAt DateTime @default(now())

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, filePath])
  @@map("source_maps")
}

enum AlertChannelType {
  SLACK
  DISCORD
  TELEGRAM
  EMAIL
}

enum AlertTrigger {
  NEW_ISSUE
  REGRESSION
  SPIKE
  METRIC
}

enum MetricComparator {
  ABOVE
  BELOW
}

enum DeliveryStatus {
  SENT
  FAILED
}

model AlertChannel {
  id        String           @id @default(uuid())
  type      AlertChannelType
  name      String
  configEnc String
  hint      String
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  rules      AlertRule[]
  deliveries AlertDelivery[]

  @@map("alert_channels")
}

model AlertRule {
  id                String             @id @default(uuid())
  projectId         String
  name              String
  trigger           AlertTrigger
  spikeThreshold    Int?
  spikeWindowMins   Int?
  metricSource      WidgetSource?
  metricName        String?
  metricAggregation WidgetAggregation?
  metricComparator  MetricComparator?
  metricThreshold   Float?
  metricWindowMins  Int?
  metricTagKey      String?
  metricTagValue    String?
  minLevel          String             @default("error")
  environment       String?
  cooldownMins      Int                @default(30)
  enabled           Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channels   AlertChannel[]
  deliveries AlertDelivery[]

  @@index([projectId, trigger, enabled])
  @@map("alert_rules")
}

model AlertDelivery {
  id        String         @id @default(uuid())
  ruleId    String?
  channelId String?
  issueId   String?
  status    DeliveryStatus
  error     String?
  createdAt DateTime       @default(now())

  rule    AlertRule?    @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  channel AlertChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([ruleId, issueId, createdAt])
  @@index([createdAt])
  @@map("alert_deliveries")
}

model InstanceSetting {
  key       String   @id
  valueEnc  String
  updatedAt DateTime @updatedAt

  @@map("instance_settings")
}

enum MetricType {
  COUNTER
  GAUGE
  DISTRIBUTION
}

enum WidgetSource {
  METRIC
  TRANSACTIONS
  ERRORS
}

enum WidgetAggregation {
  AVG
  SUM
  MIN
  MAX
  COUNT
  P50
  P95
  P99
  RATE
}

enum WidgetDisplay {
  LINE
  BAR
  NUMBER
  TABLE
}

model Transaction {
  id          String   @id @default(uuid())
  eventId     String
  projectId   String
  traceId     String
  name        String
  op          String
  status      String   @default("ok")
  timestamp   DateTime
  durationMs  Float
  release     String?
  environment String?
  spans       Json
  tags        Json
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, eventId])
  @@index([projectId, name, timestamp])
  @@index([projectId, timestamp])
  @@index([traceId])
  @@map("transactions")
}

model Metric {
  id          String     @id @default(uuid())
  projectId   String
  name        String
  type        MetricType
  value       Float
  unit        String?
  tags        Json
  release     String?
  environment String?
  timestamp   DateTime
  createdAt   DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, name, timestamp])
  @@index([projectId, timestamp])
  @@map("metrics")
}

model MetricRollup {
  id          String     @id @default(uuid())
  projectId   String
  name        String
  type        MetricType
  unit        String?
  environment String     @default("")
  tags        Json
  tagsKey     String
  bucket      DateTime
  count       Int
  sum         Float
  min         Float
  max         Float
  p50         Float
  p95         Float
  p99         Float

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name, type, environment, tagsKey, bucket])
  @@index([projectId, name, bucket])
  @@index([bucket])
  @@map("metric_rollups")
}

model Dashboard {
  id        String   @id @default(uuid())
  projectId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  widgets DashboardWidget[]

  @@index([projectId])
  @@map("dashboards")
}

model DashboardWidget {
  id          String            @id @default(uuid())
  dashboardId String
  title       String
  source      WidgetSource
  metricName  String?
  filterName  String?
  aggregation WidgetAggregation @default(AVG)
  display     WidgetDisplay     @default(LINE)
  groupBy     String?
  tagKey      String?
  tagValue    String?
  position    Int               @default(0)
  createdAt   DateTime          @default(now())

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId, position])
  @@map("dashboard_widgets")
}

model Replay {
  id            String   @id @default(uuid())
  projectId     String
  replayId      String
  startedAt     DateTime
  lastEventAt   DateTime
  durationMs    Int      @default(0)
  chunkCount    Int      @default(0)
  eventCount    Int      @default(0)
  url           String?
  userAgent     String?
  release       String?
  environment   String?
  userId        String?
  errorEventIds String[]
  createdAt     DateTime @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks  ReplayChunk[]

  @@unique([projectId, replayId])
  @@index([projectId, startedAt])
  @@map("replays")
}

model ReplayChunk {
  id       String @id @default(uuid())
  replayId String
  sequence Int
  events   Json

  replay Replay @relation(fields: [replayId], references: [id], onDelete: Cascade)

  @@unique([replayId, sequence])
  @@map("replay_chunks")
}

model Invite {
  id          String    @id @default(uuid())
  email       String
  role        UserRole
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  invitedBy User? @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("invites")
}
