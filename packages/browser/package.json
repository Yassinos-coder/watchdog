{
  "name": "@watchdog-sdk/browser",
  "version": "0.12.0",
  "description": "Watchdog SDK for browsers: global error handlers, breadcrumbs and request context",
  "keywords": [
    "watchdog",
    "error-tracking",
    "error-monitoring",
    "browser",
    "breadcrumbs",
    "sdk"
  ],
  "license": "MIT",
  "author": "Watchdog contributors",
  "homepage": "https://yassinos-coder.github.io/watchdog/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yassinos-coder/watchdog.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/Yassinos-coder/watchdog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@watchdog-sdk/core": "workspace:*"
  },
  "devDependencies": {
    "@rrweb/record": "^2.2.1",
    "jsdom": "^31.0.0",
    "rimraf": "^6.1.4",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@rrweb/record": "^2.2.1"
  },
  "peerDependenciesMeta": {
    "@rrweb/record": {
      "optional": true
    }
  }
}
