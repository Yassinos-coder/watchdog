{
  "name": "@watchdog-sdk/react",
  "version": "0.8.0",
  "description": "Watchdog SDK for React: error boundary, hooks and React 19 root error handlers",
  "keywords": [
    "watchdog",
    "error-tracking",
    "react",
    "error-boundary",
    "react-19",
    "sdk"
  ],
  "license": "MIT",
  "author": "Watchdog contributors",
  "homepage": "https://yassinos-coder.github.io/watchdog/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yassinos-coder/watchdog.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Yassinos-coder/watchdog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@watchdog-sdk/browser": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "rimraf": "^6.1.4",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@testing-library/react": "^16.3.0",
    "@watchdog-sdk/core": "workspace:*"
  }
}
