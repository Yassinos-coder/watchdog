{
  "name": "@watchdog-sdk/cli",
  "version": "0.8.0",
  "description": "Watchdog command line tool: upload source maps from your build",
  "keywords": [
    "watchdog",
    "source-maps",
    "sourcemaps",
    "cli",
    "error-tracking"
  ],
  "license": "MIT",
  "author": "Watchdog contributors",
  "homepage": "https://yassinos-coder.github.io/watchdog/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yassinos-coder/watchdog.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Yassinos-coder/watchdog/issues"
  },
  "type": "module",
  "bin": {
    "watchdog": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "rimraf": "^6.1.4",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "@types/node": "^26.6.6"
  }
}
